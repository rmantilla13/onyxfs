{
  "name": "onyx",
  "version": "0.1.0",
  "description": "Onyx \u2014 a private file workspace. Web control plane + desktop client that mounts S3 filespaces as a local drive.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-local.mjs",
    "dev:stop": "node scripts/dev-local.mjs stop",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --import ./test/alias-hook.mjs --test \"test/*.test.js\"",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.7.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@vercel/blob": "^0.27.0",
    "drizzle-orm": "^0.36.4",
    "ffmpeg-static": "^5.3.0",
    "next": "^14.2.31",
    "next-auth": "5.0.0-beta.22",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
