{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Onyx",
  "version": "0.1.0",
  "identifier": "io.onyxfs.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Onyx",
        "width": 1100,
        "height": 720,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "onyxfs"
        ]
      }
    },
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": [
        "https://github.com/rmantilla13/onyxfs/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "externalBin": [
      "binaries/rclone"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "appPosition": {
          "x": 200,
          "y": 160
        },
        "applicationFolderPosition": {
          "x": 500,
          "y": 160
        },
        "windowSize": {
          "width": 700,
          "height": 380
        }
      }
    },
    "resources": [
      "../install-deps.command",
      "icons/icon.icns"
    ]
  }
}
