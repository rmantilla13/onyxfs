# ── Required ────────────────────────────────────────────────────────────────

# Postgres (Supabase). Use the CONNECTION POOLER string — port 6543,
# transaction mode — not the direct connection on port 5432. Each serverless
# invocation opens its own socket, so the direct URL exhausts the connection
# limit under any real traffic.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# POSTGRES_URL is a valid fallback: lib/db.js reads DATABASE_URL first and
# falls back to it, which is what the Supabase-Vercel integration injects. So a
# deployment can be running entirely on POSTGRES_URL while everyone assumes
# DATABASE_URL is doing the work. If you are tidying up to a single variable,
# confirm DATABASE_URL holds a working string FIRST — the other order removes
# the only connection string the deployment has. `npm run doctor` and
# /api/health both report which one is actually in use.
#
# There is no migration step: every table is created lazily on first use.
# Run `npm run doctor` to create the schema and verify the connection.
DATABASE_URL=

# Session signing. Generate with: openssl rand -base64 32
# This one is deliberately NOT overridable from the admin panel (lib/config.js
# LOCKED_KEYS): storing the key that signs sessions behind the session it signs
# is circular, and rotating it mid-request would lock everyone out.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Magic-link sign-in. Without these, nobody can sign in at all — except under
# `next dev`, where a blank RESEND_API_KEY prints the link to the terminal.
RESEND_API_KEY=
NOTIFY_FROM="Onyx <noreply@onyxfs.io>"

# ── Access ──────────────────────────────────────────────────────────────────
# Onyx is invite-only: with no domain set, only ADMIN_EMAILS and addresses with
# an approved invite row can sign in.
#
# There are deliberately no NEXT_PUBLIC_ mirrors here. This file used to list
# four of them; they were read through an `isClient` parameter that nothing
# passed, and every importer of lib/auth-allowlist.js is server-side, so they
# did nothing at all — while NEXT_PUBLIC_ADMIN_EMAILS would have published the
# admin list into the browser bundle. `npm run doctor` now says so if it finds
# one still set. If a client component needs to know the user is an admin,
# pass it down as a prop from a server component.
#
# Unset, ADMIN_EMAILS falls back to the bootstrap address compiled into
# lib/auth-allowlist.js, and the server logs a warning saying so. Admin is
# this list and nothing else: no role in the app makes someone an admin.
#
# Everyone else signs in by invitation — an admin approves them in Admin →
# Access. There is no domain or address allowlist; ALLOWED_EMAIL_DOMAIN and
# ALLOWED_EMAILS were documented once and never read, and `npm run doctor`
# says so if either is still set.

ADMIN_EMAILS=hi@rickymantilla.com

# Stricter subset — the storage backend, and the AI key and budget. Unset, it
# is every admin.
SUPER_ADMIN_EMAILS=hi@rickymantilla.com

# ── Optional ────────────────────────────────────────────────────────────────

# Bearer token for /api/cron/maintenance and for reaching /api/health when
# sign-in itself is broken.
CRON_SECRET=

# The lazy CREATE TABLE guards are off in production and on in development,
# which is almost always what you want. Set 0 to force them on (a deployment
# that must bootstrap its own schema), 1 to force them off locally.
# SCHEMA_MANAGED=

NEXT_PUBLIC_APP_URL=https://onyxfs.io

# Fallback object store, used automatically when no S3 bucket is configured.
# Blob cannot be mounted — filespaces and the desktop app need S3.
# BLOB_READ_WRITE_TOKEN=

# Posts access requests and usage-rights expiry warnings to a channel.
# SLACK_WEBHOOK_URL=

# Okta SSO — registered only when all three are present.
# AUTH_OKTA_ID=
# AUTH_OKTA_SECRET=
# AUTH_OKTA_ISSUER=
# NEXT_PUBLIC_OKTA_ENABLED=true

# NOTE: S3 is NOT configured here. The bucket, region and keys live in
# Admin → Storage so they can be tested and changed without a redeploy.
