# ── Required ────────────────────────────────────────────────────────────────

# Postgres (Supabase). Use the CONNECTION POOLER string — port 6543,
# transaction mode — not the direct connection on port 5432. Each serverless
# invocation opens its own socket, so the direct URL exhausts the connection
# limit under any real traffic.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# There is no migration step: every table is created lazily on first use.
# Run `npm run doctor` to create the schema and verify the connection.
DATABASE_URL=

# Session signing. Generate with: openssl rand -base64 32
# This one is deliberately NOT overridable from the admin panel (lib/config.js
# LOCKED_KEYS): storing the key that signs sessions behind the session it signs
# is circular, and rotating it mid-request would lock everyone out.
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Magic-link sign-in. Without these, nobody can sign in at all.
RESEND_API_KEY=
NOTIFY_FROM="Onyx <noreply@onyxfs.io>"

# ── Access ──────────────────────────────────────────────────────────────────
# Onyx is invite-only: with no domain set, only ADMIN_EMAILS and addresses with
# an approved invite row can sign in. Set the NEXT_PUBLIC_ mirrors identically,
# or a preview deploy will disagree with production about who has access.

ADMIN_EMAILS=hi@rickymantilla.com
NEXT_PUBLIC_ADMIN_EMAILS=hi@rickymantilla.com

# Stricter subset — brand config, storage config and the secret override panel.
SUPER_ADMIN_EMAILS=hi@rickymantilla.com
NEXT_PUBLIC_SUPER_ADMIN_EMAILS=hi@rickymantilla.com

# Optional: let a whole domain in without individual invites.
# ALLOWED_EMAIL_DOMAIN=onyxfs.io
# NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=onyxfs.io

# ── Optional ────────────────────────────────────────────────────────────────

# Bearer token for /api/cron/maintenance and for reaching /api/health when
# sign-in itself is broken.
CRON_SECRET=

# The lazy CREATE TABLE guards are off in production and on in development,
# which is almost always what you want. Set 0 to force them on (a deployment
# that must bootstrap its own schema), 1 to force them off locally.
# SCHEMA_MANAGED=

NEXT_PUBLIC_APP_URL=https://onyxfs.io

# Fallback object store, used automatically when no S3 bucket is configured.
# Blob cannot be mounted — filespaces and the desktop app need S3.
# BLOB_READ_WRITE_TOKEN=

# SLACK_WEBHOOK_URL=

# Okta SSO — registered only when all three are present.
# AUTH_OKTA_ID=
# AUTH_OKTA_SECRET=
# AUTH_OKTA_ISSUER=
# NEXT_PUBLIC_OKTA_ENABLED=true

# NOTE: S3 is NOT configured here. The bucket, region and keys live in
# Admin → Storage so they can be tested and changed without a redeploy.
