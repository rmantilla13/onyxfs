<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array><string>group.io.onyxfs</string></array>
  <!-- Must match the app's. The extension reads the token the app wrote; if
       this is missing the keychain returns -34018 and the drive enumerates
       empty rather than reporting an error. -->
  <key>keychain-access-groups</key>
  <array><string>$(AppIdentifierPrefix)group.io.onyxfs</string></array>
  <key>com.apple.security.network.client</key><true/>
</dict>
</plist>
