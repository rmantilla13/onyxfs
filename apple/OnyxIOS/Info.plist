<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Onyx</string>
	<!-- The PKCE callback: onyxfs://callback?code=… (lib/brand.js, and the Mac's). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.onyxfs.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>onyxfs</string>
			</array>
		</dict>
	</array>
	<!-- HTTPS everywhere, except an Onyx on this network or this machine: a
	     self-hosted server by its .local name, or a test one on localhost. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Standard HTTPS only: exempt from export documentation. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Picture in picture keeps playing when the app is left. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
